# ── Supabase ────────────────────────────────────────────────────────
#
# Les deux valeurs sont publiques : elles partent dans le navigateur.
# La clé anonyme n'ouvre aucun accès par elle-même — tout est encadré
# par les politiques RLS.
#
# Où les trouver : tableau de bord Supabase → Project Settings → API.
#   • Project URL      → NEXT_PUBLIC_SUPABASE_URL
#   • anon / public key → NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# ⚠️ Ne jamais mettre ici la clé « service_role » : elle contourne RLS.
#
# Tant que ces deux variables sont absentes, l'application tourne sur le
# jeu de démonstration — pratique pour travailler l'interface, mais le
# démarrage échoue si elles manquent en production.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── API IMAFRIK ─────────────────────────────────────────────────────
# Base du service FastAPI. Laisser vide en développement pour continuer
# à servir le jeu de démonstration.
NEXT_PUBLIC_API_URL=

# ── Viewer d'imagerie ───────────────────────────────────────────────
# Adresse du viewer OHIF servi par le backend. Seule origine que la
# politique de sécurité du contenu autorise dans un cadre : absente,
# l'écran de lecture ne peut pas afficher les images.
#   ex. https://viewer.imafrik.tech/viewer
NEXT_PUBLIC_VIEWER_URL=

# ── Adresse publique du site ────────────────────────────────────────
# Sert aux liens des courriels (réinitialisation du mot de passe,
# invitations) et au lien de vérification imprimé sur les comptes-rendus.
#   ex. https://imafrik.tech
NEXT_PUBLIC_SITE_URL=

# ── Copies de secours des brouillons ────────────────────────────────
# Secret serveur — jamais NEXT_PUBLIC_. Dérive, pour chaque compte, la clé
# qui chiffre sur le poste le brouillon qu'une coupure a empêché d'envoyer.
# 32 caractères au moins ; une production qui en est privée refuse de
# servir. Le changer rend illisibles les copies en cours, sans autre effet.
#   openssl rand -base64 48
REPORT_BACKUP_SECRET=

# ── Hébergement hors Vercel ─────────────────────────────────────────
# À poser à « production » sur tout serveur de production qui n'est pas
# Vercel : sans lui, un déploiement privé de ses variables servirait le
# jeu de démonstration au lieu de refuser.
# IMAFRIK_ENV=production
