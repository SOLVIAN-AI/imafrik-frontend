{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "api:types": "openapi-typescript ${IMAFRIK_OPENAPI:-../backend/services/api/openapi.json} -o src/lib/api/schema.d.ts",
    "api:check": "openapi-typescript ${IMAFRIK_OPENAPI:-../backend/services/api/openapi.json} -o /tmp/imafrik-schema.d.ts && diff -q /tmp/imafrik-schema.d.ts src/lib/api/schema.d.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" playwright.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" playwright.config.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "video:demo": "playwright test --config playwright.demo.config.ts && tools/demo-video/assembler.sh"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@sentry/browser": "^11.8.0",
    "@sentry/nextjs": "^11.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tiptap/extension-character-count": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-subscript": "^3.32.0",
    "@tiptap/extension-superscript": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "^4.14.5",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tus-js-client": "4.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "happy-dom": "^21.0.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
